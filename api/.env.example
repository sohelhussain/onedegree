# ==============================================================================
# 1degree API (Axum) — Environment Configuration Template
# ==============================================================================

# Server
PORT=8080
HOST=0.0.0.0
RUST_LOG=info,api=debug,tower_http=debug
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL 16)
# Local Docker database (default)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onedegree
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/onedegree

# Optional: Cloud Neon database (development branch)
# For local work, use the direct, non-pooled connection string of the Neon "dev" branch.
# Production values live only in the host dashboard.
# DATABASE_URL_NEON=postgres://username:password@ep-sample-dev.ap-southeast-1.aws.neon.tech/onedegree?sslmode=require

# Security & Secrets
# Replace with a high-entropy secret key of at least 32 bytes
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION_SECS=900          # 15 minutes
JWT_REFRESH_EXPIRATION_SECS=2592000     # 30 days

# Administrators (comma-separated lowercase emails)
ADMIN_EMAILS=admin@example.com

# Authentication Providers
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
